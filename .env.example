# Steel API key. Server-side only — never referenced from a client component.
# Get one at https://app.steel.dev  ($30 free credit)
STEEL_API_KEY=

# Set to 1 to run entirely offline against lib/fixtures. No Steel calls, no key.
# Workstreams B, C and D can develop with this on.
MOCK_STEEL=1

# Optional. Upgrades the justification text when set; the app works fully
# without it and falls back to the templated version. Server-side only —
# never prefix this NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
